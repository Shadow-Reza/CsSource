#!/usr/bin/env bash
# css-genconf <instance> — render per-instance config into the instance's overlay (merged root must be mounted).
# Sources: /opt/css/etc/instances/<i>.env, /opt/css/etc/templates/**, /opt/css/etc/secrets/{db.env,<i>.env}
# Writes (all inside /opt/css/instances/<i>/root/cstrike):
#   cfg/server.cfg cfg/instance.cfg cfg/mode_<mode>.cfg cfg/server_secrets.cfg cfg/sourcemod/chogan.cfg
#   mapcycle.txt motd.txt addons/sourcemod/configs/databases.cfg
#   plugins: copies addons/sourcemod/plugins/optional/<mode>/*.smx (from base) into addons/sourcemod/plugins/
set -euo pipefail
n="${1:?instance}"; I="/opt/css/instances/$n"; R="$I/root/cstrike"; T=/opt/css/etc/templates; SECD=/opt/css/etc/secrets
mountpoint -q "$I/root" || { echo "overlay for $n not mounted (systemctl start css-overlay@$n)" >&2; exit 1; }
set -a; . "/opt/css/etc/instances/$n.env"; . "$SECD/db.env"; set +a
u="css-$n"
# per-instance secrets (rcon) — generate once
mkdir -p "$SECD"; if [ ! -s "$SECD/$n.env" ]; then (umask 077; echo "RCON_PASSWORD=$(openssl rand -hex 16)" > "$SECD/$n.env"); fi
set -a; . "$SECD/$n.env"; set +a
: "${CSS_MODE:?}" "${CSS_HOSTNAME:?}" "${CSS_TICKRATE:=66}" "${CSS_BOTQUOTA:=0}" "${CSS_CONTACT:=}"
if [ "$CSS_TICKRATE" -ge 100 ]; then MAXUPDATERATE=100; MAXCMDRATE=100; else MAXUPDATERATE=66; MAXCMDRATE=66; fi
render() { # render <template> <dest> <mode> <owner> � python does the @@VAR@@ substitution (values may contain any char)
  RENDER_IN="$1" RENDER_OUT="$2.tmp" INSTANCE="$n" MODE="$CSS_MODE" HOSTNAME_="$CSS_HOSTNAME" CONTACT="$CSS_CONTACT" BOTQUOTA="$CSS_BOTQUOTA"   MAXUPDATERATE="$MAXUPDATERATE" MAXCMDRATE="$MAXCMDRATE" RCON_PASSWORD="$RCON_PASSWORD" DB_NAME_SM="$DB_NAME_SM" DB_SM_USER="$DB_SM_USER"   DB_SM_PASS="$DB_SM_PASS" DB_NAME_AGENT="$DB_NAME_AGENT" python3 - <<'PYR'
import os
m={"INSTANCE":"INSTANCE","MODE":"MODE","HOSTNAME":"HOSTNAME_","CONTACT":"CONTACT","BOTQUOTA":"BOTQUOTA","MAXUPDATERATE":"MAXUPDATERATE",
   "MAXCMDRATE":"MAXCMDRATE","RCON_PASSWORD":"RCON_PASSWORD","DB_NAME_SM":"DB_NAME_SM","DB_SM_USER":"DB_SM_USER","DB_SM_PASS":"DB_SM_PASS","DB_NAME_AGENT":"DB_NAME_AGENT"}
t=open(os.environ["RENDER_IN"]).read()
for k,e in m.items(): t=t.replace("@@"+k+"@@", os.environ.get(e,""))
open(os.environ["RENDER_OUT"],"w").write(t)
PYR
  install -m "$3" -o "$4" -g css "$2.tmp" "$2"; rm -f "$2.tmp"
}
mkdir -p "$R/cfg/sourcemod" "$R/addons/sourcemod/configs" "$R/addons/sourcemod/plugins" "$R/logs" "$R/addons/sourcemod/logs"
render "$T/server.cfg"            "$R/cfg/server.cfg"            0644 "$u"
render "$T/modes/$CSS_MODE.cfg"   "$R/cfg/mode_$CSS_MODE.cfg"    0644 "$u"
render "$T/mapcycles/$CSS_MODE.txt" "$R/mapcycle.txt"            0644 "$u"
render "$T/motd.txt"              "$R/motd.txt"                  0644 "$u"
render "$T/sm/databases.cfg"      "$R/addons/sourcemod/configs/databases.cfg" 0640 "$u"
render "$T/sm/chogan.cfg"         "$R/cfg/sourcemod/chogan.cfg"  0644 "$u"
render "$T/sm/smac.cfg"           "$R/cfg/sourcemod/smac.cfg"    0644 "$u"
render "$T/sm/lilac_config.cfg"   "$R/cfg/sourcemod/lilac_config.cfg" 0644 "$u"
# admins: live list from /opt/css/etc/admins_simple.ini if present, else the (empty) template
ADM=/opt/css/etc/admins_simple.ini; [ -r "$ADM" ] || ADM="$T/sm/admins_simple.ini"
install -m 0640 -o "$u" -g css "$ADM" "$R/addons/sourcemod/configs/admins_simple.ini"
# instance.cfg: things that come straight from env
{ echo "// generated by css-genconf for $n"; echo "hostname \"$CSS_HOSTNAME\""; echo "sv_maxupdaterate $MAXUPDATERATE"; echo "sv_maxcmdrate $MAXCMDRATE";
  [ -r "/opt/css/etc/instances/$n.cfg" ] && cat "/opt/css/etc/instances/$n.cfg"; } > "$R/cfg/instance.cfg.tmp"
install -m 0644 -o "$u" -g css "$R/cfg/instance.cfg.tmp" "$R/cfg/instance.cfg"; rm -f "$R/cfg/instance.cfg.tmp"
# secrets: rcon
{ echo "rcon_password \"$RCON_PASSWORD\""; } > "$R/cfg/server_secrets.cfg.tmp"
install -m 0600 -o "$u" -g css "$R/cfg/server_secrets.cfg.tmp" "$R/cfg/server_secrets.cfg"; rm -f "$R/cfg/server_secrets.cfg.tmp"
# mode plugins from base's optional pool
OPT="/opt/css/base/cstrike/addons/sourcemod/plugins/optional/$CSS_MODE"
if [ -d "$OPT" ]; then for p in "$OPT"/*.smx; do [ -e "$p" ] && install -m 0644 -o "$u" -g css "$p" "$R/addons/sourcemod/plugins/$(basename "$p")"; done; fi
# fix ownership of the writable dirs
chown -R "$u:css" "$R/logs" "$R/addons/sourcemod/logs" 2>/dev/null || true
echo "css-genconf: rendered $n (mode=$CSS_MODE tick=$CSS_TICKRATE)"
