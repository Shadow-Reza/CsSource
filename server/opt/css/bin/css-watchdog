#!/usr/bin/env python3
"""css-watchdog — A2S liveness watchdog for css@* instances (MISSION §6.7).
srcds can hang while still holding its port; systemd never notices. Every run (systemd timer, 30 s):
for each active css@<i>: A2S_INFO to <CSS_IP>:<port> (2 tries, 2 s each). Consecutive failures are
counted in /run/css/watchdog/<i>.fails; at FAIL_LIMIT we `systemctl restart css@<i>` and log loudly.
Instances started less than GRACE_SEC ago are skipped (map load). Run as root."""
import os, re, socket, subprocess, sys, time, json
FAIL_LIMIT = int(os.environ.get("CSS_WD_FAIL_LIMIT", "4"))
GRACE_SEC = int(os.environ.get("CSS_WD_GRACE", "120"))
STATE = "/run/css/watchdog"; os.makedirs(STATE, exist_ok=True)
INSTANCES = ["pub1", "pub2", "dm", "gg", "awp", "m1", "m2"]
def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout.strip()
def a2s(host, port, timeout=2.0):
    q = b"\xff\xff\xff\xffTSource Engine Query\x00"
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(timeout)
    try:
        s.sendto(q, (host, port)); d, _ = s.recvfrom(4096)
        if d[4:5] == b"A":
            s.sendto(q + d[5:9], (host, port)); d, _ = s.recvfrom(4096)
        return d[4:5] == b"I"
    except (socket.timeout, OSError):
        return False
    finally:
        s.close()
def main():
    out = []
    for n in INSTANCES:
        if sh("systemctl", "is-active", f"css@{n}") != "active":
            continue
        env = open(f"/opt/css/etc/instances/{n}.env").read()
        port = int(re.search(r"^CSS_PORT=(\d+)", env, re.M).group(1))
        host = re.search(r"^CSS_IP=(\S+)", env, re.M).group(1)  # srcds binds the public IP only; loopback routing still applies
        # uptime of the main process
        ts = sh("systemctl", "show", f"css@{n}", "-p", "ExecMainStartTimestampMonotonic", "--value")
        try:
            up = time.monotonic() - int(ts) / 1e6
        except ValueError:
            up = 999999
        ff = f"{STATE}/{n}.fails"
        fails = int(open(ff).read() or 0) if os.path.exists(ff) else 0
        if up < GRACE_SEC:
            out.append(f"{n}: grace ({int(up)}s)"); continue
        ok = a2s(host, port) or a2s(host, port)
        fails = 0 if ok else fails + 1
        open(ff, "w").write(str(fails))
        if ok:
            out.append(f"{n}: ok")
        elif fails >= FAIL_LIMIT:
            subprocess.run(["systemctl", "restart", f"css@{n}"])
            open(ff, "w").write("0")
            msg = f"{n}: NO A2S reply {fails}x on 127.0.0.1:{port} — RESTARTED css@{n}"
            subprocess.run(["logger", "-t", "css-watchdog", "-p", "daemon.err", msg]); out.append(msg)
        else:
            msg = f"{n}: no A2S reply ({fails}/{FAIL_LIMIT})"
            subprocess.run(["logger", "-t", "css-watchdog", "-p", "daemon.warning", msg]); out.append(msg)
    print("css-watchdog: " + "; ".join(out) if out else "css-watchdog: no active instances")
if __name__ == "__main__":
    main()
