#!/usr/bin/env bash
# deploy-server-tree — push every file under server/ (except provision/) to the VM at the same path (root-owned).
# Files under server/opt/css/bin get 0755. Units get 0644 and systemd is reloaded.
set -euo pipefail
cd "$(dirname "$0")/.."
CR=$(printf '\r')
if grep -rlI "$CR" server 2>/dev/null | head -1 | grep -q .; then
  echo "deploy-server-tree: CRLF line endings found in:"; grep -rlI "$CR" server; exit 1
fi
find server -type f ! -path 'server/provision/*' | while read -r f; do
  rel="${f#server}"; mode=0644
  case "$rel" in /opt/css/bin/*|*.sh) mode=0755;; esac
  ./scripts/rput "$f" "$rel" "$mode" root:root < /dev/null
done
./scripts/rroot 'systemctl daemon-reload && echo daemon-reloaded'
